# Production env for the Next app — set these as env vars on the Coolify service (NOT committed).
# All are read SERVER-SIDE only; none are exposed to the browser.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# NEVER ship the service-role key to the browser. Used only by serviceCommand() (invite exchange, imports).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required canonical public HTTPS origin. Invite URLs are derived only from this value, never request headers.
PUBLIC_SITE_URL=https://sangam.example

# Keep the invite exchange OFF until the hosted real-auth and browser acceptance journey is certified.
# Code-only email OTP and persistent sessions are implemented; set to 1 only after the release gate passes.
INVITE_EXCHANGE_ENABLED=0
