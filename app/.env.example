# Client + server (safe to expose to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server ONLY — never ship to the browser. Used exclusively by narrow named serviceCommand() paths,
# including imports/webhooks/jobs and verified-session invite issuance/exchange.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public HTTPS origin used to create host-issued invite URLs. No path/query/fragment.
PUBLIC_SITE_URL=

# Feature gate for the single-use invite exchange (/invite/[token]). Leave unset/0 until the hosted
# real-auth and browser acceptance journey is certified; set to 1 only after that release gate passes.
INVITE_EXCHANGE_ENABLED=

# Optional controlled room-planning workbook. Credentials are server-only; share only this workbook with it.
ROOM_SHEET_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
